# users.yaml — 用户配置模板（复制后移除 .example 后缀使用）
# Users config template — remove .example suffix before use
#
# 安全说明: 该文件包含密码哈希，切勿提交到公开仓库。
# Security note: This file contains password hashes. NEVER commit to public repos.
#
# 字段说明 / Fields:
#   role: admin | operator | analyst
#   hash: Argon2id 哈希 (v0.5.6 起)。格式:
#         $argon2id$v=19$m=19456,t=2,p=1$<salt>$<digest> (参数与 server/auth.py 一致)
#   created: 创建时间
#   initial: true=初始密码（登录后强制改密）
#
# 注: 首次面板启动会自动创建 admin 并打印初始密码，通常无需手编此文件。

# ⚠️ 首次启动面板会自动创建 admin 用户，密码打印在面板终端。
#    你通常不需要手动编辑此文件。
# ⚠️ On first dashboard launch, an admin user is automatically created
#    with password printed to the terminal. Manual editing is NOT needed.
#
# v0.6.4 (审查修复 H4): 模板不再含任何固定 salt/hash 占位 —
#   旧模板带固定 SHA256 形态 hash 与独立 salt, 复制即产生可疑凭据,
#   且与 Argon2id 自含盐设计矛盾。现默认留空, 由
#   AuthManager.ensure_initial_admin() 首次启动自动生成并回填。

users: {}
# ⚠️ 留空即"首次启动自动创建 admin"。
# 如需预置用户, 请按上方字段说明填入 Argon2id hash:
#   users:
#     admin:
#       role: admin
#       hash: "$argon2id$v=19$m=19456,t=2,p=1$<真实生成值, 勿用示例>"
#       created: "2026-01-01T00:00:00"
#       initial: false
